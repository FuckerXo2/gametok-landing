# Redirect www to non-www
https://www.gametok.co/* https://gametok.co/:splat 301!

# Redirect http to https (if needed)
http://gametok.co/* https://gametok.co/:splat 301!
http://www.gametok.co/* https://gametok.co/:splat 301!

# SPA routes — the React app owns these paths, so a cold load or a shared link
# has to be served index.html instead of 404ing.
#
# Listed explicitly rather than as a catch-all (/* -> /index.html) on purpose:
# the deploy also contains real static paths at the root (about/, more/,
# download/, admin.html, game.html, .well-known/, assets/, app-assets/,
# home-videos/) plus the game.html Pages Function, and a catch-all risks
# shadowing them. Add a line here whenever a route is added to parseRoute.
# NOTE: /about collides with the legacy static about/index.html. This rule makes
# the React page win on a cold load; the images under /about/ (icon.png,
# game-cards-hero-sm.png) are deeper paths and are NOT matched, so the meta tags
# in index.html keep working. Verify after deploy, and retire about/index.html
# once the React page is the real one.
/about /index.html 200
/explore /index.html 200
/explore/* /index.html 200
/create /index.html 200
/connect /index.html 200
/profile /index.html 200
/play /index.html 200
/game/* /index.html 200
/blog /index.html 200
/blog/* /index.html 200
/changelog /index.html 200
/games /index.html 200
/pricing /index.html 200
/earn /index.html 200
/faq /index.html 200
/privacy /index.html 200
/terms /index.html 200
